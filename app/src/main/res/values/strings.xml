    <!-- Onboarding -->
    <string name="onboarding_title">Your AI, on this phone</string>
    <string name="onboarding_body">SmolChat Server runs a language model on your device and lets apps you approve use it. A few things help it run reliably.</string>
    <string name="onboarding_notifications">Notifications</string>
    <string name="onboarding_notifications_body">The server shows a persistent notification while it runs, with a Stop button.</string>
    <string name="onboarding_battery">Unrestricted battery</string>
    <string name="onboarding_battery_body">Lets the server keep running in the background while other apps use it.</string>
    <string name="onboarding_network">Network permission for apps</string>
    <string name="onboarding_network_body">On GrapheneOS, turn on the Network permission for every app that should use the server (Settings, Apps, the app, Permissions). Localhost counts as network. This server never connects to the internet.</string>
    <string name="onboarding_model">A model</string>
    <string name="onboarding_model_body">Import a GGUF file. The default and recommended model is Qwen3.5-4B-Q4_K_M.</string>
    <string name="onboarding_ok">Done</string>
    <string name="onboarding_done">Continue</string>

